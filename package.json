{
  "name": "rn-template",
  "main": "src/index.ts",
  "version": "1.2.0",
  "description": "This is a React Native template with Expo and TypeScript.",
  "author": {
    "name": "Eduardo Andrade",
    "email": "eduardo@andradee.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 24.19.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:clean": "expo run:ios --no-build-cache",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "clean-project": "sh ./scripts/clean-project.sh",
    "prebuild": "expo prebuild --clean",
    "expo:check:deps": "expo install --check",
    "expo:update:deps": "expo install --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.14.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-cookies": "^1.1.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-unistyles": "^3.1.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
