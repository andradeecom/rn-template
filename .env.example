# Backend provider — which adapter src/adapters resolves at startup.
# "api" (default) targets the proprietary REST backend; "supabase" uses supabase-js.
EXPO_PUBLIC_API_PROVIDER="api"

# Supabase — only needed when EXPO_PUBLIC_API_PROVIDER="supabase".
# The client is created lazily, so leaving these unset is safe for the "api" provider.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""